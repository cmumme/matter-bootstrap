{
	"name": "AttackOfTheKillerRoombas",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
	  "$className": "DataModel",
	  "ServerScriptService": {
		"$className": "ServerScriptService",
		"TS": {
			"$path": "out/server"
		}
	  },
	  "StarterPlayer": {
		"$className": "StarterPlayer",
		"StarterPlayerScripts": {
			"$className": "StarterPlayerScripts",
			"TS": {
				"$path": "out/client"
			}
	  	}
	  },
	  "Workspace": {
		"$className": "Workspace",
		"Terrain": {
		  "$path": "assets/terrain.rbxm"
		},
		"Level": {
		  "$path": "assets/level.rbxm"
		}
	  },
	  "ReplicatedStorage": {
		"$className": "ReplicatedStorage",
  
		"Assets": {
		  "$path": "assets/assets.rbxm"
		},
		"rbxts_include": {
			"$path": "include",
			"node_modules": {
				"$className": "Folder",
				"@rbxts": {
					"$path": "node_modules/@rbxts"
				}
			}
		},
		"TS": {
			"$path": "out/shared"
		}
	  }
	}
  }
  